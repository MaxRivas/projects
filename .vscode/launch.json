{
  // VS Code launch configurations for MoviesApi
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch MoviesApi (Kestrel)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build MoviesApi",
      "program": "${workspaceFolder}/MoviesApi/bin/Debug/net9.0/MoviesApi.dll",
      "args": [],
      "cwd": "${workspaceFolder}/MoviesApi",
      "stopAtEntry": false,
      "console": "internalConsole",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Attach to MoviesApi (process)",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
    ,
    {
      "name": "Launch MoviesApi (with launch-profile)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build MoviesApi",
      // Run with the same args as: dotnet run --project MoviesApi/MoviesApi.csproj --launch-profile "Development"
      "program": "${command:dotnetExecutable}",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/MoviesApi/MoviesApi.csproj",
        "--launch-profile",
        "Development"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "internalConsole",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Debug All Tests (dotnet test)",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/MoviesApi.Tests/MoviesApi.Tests.csproj",
        "--logger:console;verbosity=detailed"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Debug Single Test (prompt for filter)",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/MoviesApi.Tests/MoviesApi.Tests.csproj",
        "--filter",
        "${input:testFilter}",
        "--logger:console;verbosity=detailed"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {
      "id": "testFilter",
      "type": "promptString",
      "description": "Enter a test filter for dotnet test (e.g. FullyQualifiedName~Namespace.Class.Method or DisplayName~MethodName)",
      "default": "FullyQualifiedName~MoviesApi.Controllers.MoviesControllerTest.Create_AddsMovie_ReturnsCreated"
    }
  ]
}
