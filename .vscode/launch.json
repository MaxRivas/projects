{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Main Program",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/bank",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "lldb",
      "preLaunchTask": "build-main",
      "setupCommands": [
        {
          "description": "Enable pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "logging": {
        "programOutput": true,
        "moduleLoad": false
      }
    },
    {
      "name": "Debug Unit Tests",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/bank_test",
      "args": [
        "--gtest_color=yes"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/build",
      "environment": [],
      "externalConsole": false,
      "MIMode": "lldb",
      "preLaunchTask": "build-tests",
      "setupCommands": [
        {
          "description": "Enable pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "logging": {
        "programOutput": true,
        "moduleLoad": false
      }
    }
  ]
}
