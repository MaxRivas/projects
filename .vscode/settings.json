{
	"cmake.buildDirectory": "${workspaceFolder}/build",
	"cmake.sourceDirectory": "${workspaceFolder}",
	"cmake.configureOnOpen": true,
	"cmake.generator": "Unix Makefiles",

	"C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
	"C_Cpp.codeAnalysis.runAutomatically": true,
	"testExplorer.useNativeTesting": false,
	"testMate.cpp.test.gtest.additionalArgs": ["--gtest_color=no"],
	"testMate.cpp.test.executables": [
		"${workspaceFolder}/build/bin/*_test",
		"${workspaceFolder}/build/bin/*Tests",
		"${workspaceFolder}/build/bin/*Test",
		"${workspaceFolder}/build/bin/bank_test"
	],

	"cmake.ctestArgs": ["--output-on-failure"]
}