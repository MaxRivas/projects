{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "dotnet test: solution",
			"type": "process",
			"command": "dotnet",
			"args": ["test", "${workspaceFolder}/projects.sln"],
			"problemMatcher": ["$msCompile"],
			"group": "test",
			"presentation": { "reveal": "always" }
		},
		{
			"label": "build MoviesApi",
			"command": "dotnet",
			"type": "process",
			"args": ["build", "${workspaceFolder}/MoviesApi/MoviesApi.csproj"],
			"problemMatcher": ["$msCompile"],
			"group": "build",
			"presentation": { "reveal": "always" }
		},
		{
			"type": "docker-build",
			"label": "docker-build",
			"platform": "node",
			"dockerBuild": {
				"dockerfile": "${workspaceFolder}/Dockerfile",
				"context": "${workspaceFolder}",
				"pull": true
			}
		},
		{
			"type": "docker-run",
			"label": "docker-run: release",
			"dependsOn": ["docker-build"],
			"platform": "node"
		},
		{
			"type": "docker-run",
			"label": "docker-run: debug",
			"dependsOn": ["docker-build"],
			"dockerRun": {
				"env": { "DEBUG": "*", "NODE_ENV": "development" }
			},
			"node": { "enableDebugging": true }
		}
	]
}