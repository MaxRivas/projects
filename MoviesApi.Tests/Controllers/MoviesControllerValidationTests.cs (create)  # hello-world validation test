using System;
using System.Collections.Generic;
using System.ComponentModel.DataAnnotations;
using Xunit;

public class MoviesControllerValidationTests
{
    [Fact]
    public void CreateMovie_WithNullTitle_ShouldFailValidation()
    {
        var movieDto = new CreateMovieDto { Title = null, Director = "Director", Genre = "Genre" };
        var validationResults = Validate(movieDto);
        Assert.Contains(validationResults, v => v.MemberNames.Contains("Title"));
    }

    [Fact]
    public void CreateMovie_WithNullDirector_ShouldFailValidation()
    {
        var movieDto = new CreateMovieDto { Title = "Title", Director = null, Genre = "Genre" };
        var validationResults = Validate(movieDto);
        Assert.Contains(validationResults, v => v.MemberNames.Contains("Director"));
    }

    [Fact]
    public void CreateMovie_WithNullGenre_ShouldFailValidation()
    {
        var movieDto = new CreateMovieDto { Title = "Title", Director = "Director", Genre = null };
        var validationResults = Validate(movieDto);
        Assert.Contains(validationResults, v => v.MemberNames.Contains("Genre"));
    }

    private IEnumerable<ValidationResult> Validate(CreateMovieDto movieDto)
    {
        var context = new ValidationContext(movieDto);
        var results = new List<ValidationResult>();
        Validator.TryValidateObject(movieDto, context, results, true);
        return results;
    }
}